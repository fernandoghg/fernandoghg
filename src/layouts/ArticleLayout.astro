---
import BaseLayout from './BaseLayout.astro';
import { articleCategoryLabels } from '../data/article-categories';
import { formatArticleDate } from '../lib/article-model';
import type { ArticlePageProps } from '../lib/articles';
type Props = ArticlePageProps;
const { article, languageHref } = Astro.props;
const { title, description, published, updated, lang, category } = article.data;
const es = lang === 'es';
---
<BaseLayout lang={lang} page="articles" title={title} description={description} languageHref={languageHref}>
  <article class="article-page reading-width">
    <header class="article-header">
      <p class="eyebrow">{articleCategoryLabels[category][lang]}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="article-dates">
        <p>{es ? 'Publicado:' : 'Published:'} <time datetime={published}>{formatArticleDate(published, lang)}</time></p>
        {updated && <p>{es ? 'Actualizado:' : 'Updated:'} <time datetime={updated}>{formatArticleDate(updated, lang)}</time></p>}
      </div>
    </header>
    <div class="article-body"><slot /></div>
  </article>
</BaseLayout>
