---
import BaseLayout from './BaseLayout.astro';
import { articleCategoryLabels } from '../data/article-categories';
import { formatArticleDate } from '../lib/article-model';
import type { ArticlePageProps } from '../lib/articles';
type Props = ArticlePageProps;
const { article, languageHref, translationHref, previous, next, project } = Astro.props;
const { title, description, published, updated, lang, category } = article.data;
const es = lang === 'es';
---
<BaseLayout lang={lang} page="articles" title={title} description={description} languageHref={languageHref} translationHref={translationHref} socialType="article">
  <article class="editorial-container article-page">
    <header class="article-header">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="article-dates">
        <p>{es ? 'Publicado:' : 'Published:'} <time datetime={published}>{formatArticleDate(published, lang)}</time> · {es ? 'Categoría:' : 'Category:'} {articleCategoryLabels[category][lang]}</p>
        {updated && <p>{es ? 'Actualizado:' : 'Updated:'} <time datetime={updated}>{formatArticleDate(updated, lang)}</time></p>}
        {project && <p>{es ? 'Proyecto:' : 'Project:'} <a href={project.href}>{project.name}</a></p>}
      </div>
    </header>
    <div class:list={['article-body', { 'top-eleven-complex-table': article.id === 'es/mi-experiencia-top-eleven-un-mes-despues' }]}><slot /></div>
    {(previous || next) && (
      <nav class="series-navigation" aria-label={es ? 'Navegación de la serie' : 'Series navigation'}>
        <ul>
          {previous && <li><a href={previous.url}>
            <span class="series-navigation-label"><span aria-hidden="true">← </span>{es ? 'Artículo anterior' : 'Previous article'}</span>
            <span>{previous.title}</span>
          </a></li>}
          {next && <li class="series-navigation-next"><a href={next.url}>
            <span class="series-navigation-label">{es ? 'Siguiente artículo' : 'Next article'}<span aria-hidden="true"> →</span></span>
            <span>{next.title}</span>
          </a></li>}
        </ul>
      </nav>
    )}
  </article>
</BaseLayout>
