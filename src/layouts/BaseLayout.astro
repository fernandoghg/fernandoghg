---
import '../styles/global.css';
import { navigation, primaryPages, type Language, type Page } from '../data/navigation';
interface Props { lang: Language; page: Page; title: string; description: string; languageHref?: string }
const { lang, page, title, description, languageHref } = Astro.props;
const links = navigation[lang];
const other = lang === 'es' ? 'en' : 'es';
const es = lang === 'es';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title} — fernandoghg.com</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{es ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="site-header container">
      <a class="site-name" href={links.home.href}>fernandoghg.com</a>
      <nav class="primary-nav" aria-label={es ? 'Navegación principal' : 'Main navigation'}>
        <ul>{primaryPages.map((key) => <li><a href={links[key].href} aria-current={key === page ? 'page' : undefined}>{links[key].label}</a></li>)}</ul>
      </nav>
      <a class="language-link" href={languageHref ?? navigation[other][page].href} lang={other} aria-label={es ? 'Switch to English' : 'Cambiar a español'}>{other.toUpperCase()}</a>
    </header>
    <main id="main" class="container" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} Fernando</p>
      <nav aria-label={es ? 'Enlaces del pie' : 'Footer links'}>
        <ul>
          <li><a href="https://github.com/fernandoghg">GitHub</a></li>
          <li><a href="https://www.instagram.com/fernandoghg/">Instagram</a></li>
          <li><a href={links.privacy.href} aria-current={page === 'privacy' ? 'page' : undefined}>{links.privacy.label}</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
