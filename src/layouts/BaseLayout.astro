---
import '../styles/global.css';
import { navigation, primaryPages, type Language, type Page } from '../data/navigation';
import { socialImage, socialLocales } from '../data/social';
interface Props { lang: Language; page?: Page; title: string; description: string; languageHref?: string; translationHref?: string; isErrorPage?: boolean; socialType?: 'website' | 'article' }
const { lang, page, title, description, languageHref, translationHref, isErrorPage = false, socialType = 'website' } = Astro.props;
const links = navigation[lang];
const other = lang === 'es' ? 'en' : 'es';
const es = lang === 'es';
const canonical = new URL(Astro.url.pathname, Astro.site);
const translation = translationHref ? new URL(translationHref, Astro.site) : undefined;
const fullTitle = `${title} — fernandoghg.com`;
const socialImageUrl = new URL(socialImage.path, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {!isErrorPage && <link rel="canonical" href={canonical.href} />}
    {!isErrorPage && translation && <>
      <link rel="alternate" hreflang={lang} href={canonical.href} />
      <link rel="alternate" hreflang={other} href={translation.href} />
    </>}
    <title>{fullTitle}</title>
    {!isErrorPage && <>
      <meta property="og:title" content={fullTitle} />
      <meta property="og:description" content={description} />
      <meta property="og:type" content={socialType} />
      <meta property="og:url" content={canonical.href} />
      <meta property="og:image" content={socialImageUrl.href} />
      <meta property="og:image:alt" content={socialImage.alt[lang]} />
      <meta property="og:image:width" content={String(socialImage.width)} />
      <meta property="og:image:height" content={String(socialImage.height)} />
      <meta property="og:image:type" content={socialImage.type} />
      <meta property="og:site_name" content="fernandoghg.com" />
      <meta property="og:locale" content={socialLocales[lang]} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={fullTitle} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={socialImageUrl.href} />
      <meta name="twitter:image:alt" content={socialImage.alt[lang]} />
    </>}
  </head>
  <body>
    <a class="skip-link" href="#main">{es ? 'Saltar al contenido' : 'Skip to content'}</a>
    <header class="site-header container">
      <a class="site-name" href={links.home.href}>fernandoghg.com</a>
      <nav class="primary-nav" aria-label={es ? 'Navegación principal' : 'Main navigation'}>
        <ul>{primaryPages.map((key) => <li><a href={links[key].href} aria-current={key === page ? 'page' : undefined}>{links[key].label}</a></li>)}</ul>
      </nav>
      <a class="language-link" href={languageHref ?? (page ? navigation[other][page].href : navigation[other].home.href)} lang={other} aria-label={es ? 'Switch to English' : 'Cambiar a español'}>{other.toUpperCase()}</a>
    </header>
    <main id="main" class="container" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} Fernando</p>
      <nav aria-label={es ? 'Enlaces del pie' : 'Footer links'}>
        <ul>
          <li><a href="https://github.com/fernandoghg">GitHub</a></li>
          <li><a href="https://www.instagram.com/fernandoghg/">Instagram</a></li>
          <li><a href={links.privacy.href} aria-current={page === 'privacy' ? 'page' : undefined}>{links.privacy.label}</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
