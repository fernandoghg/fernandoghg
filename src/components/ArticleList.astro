---
import type { Language } from '../data/navigation';
import type { Article } from '../lib/articles';
import { articleCategoryLabels } from '../data/article-categories';
import { articleUrl, formatArticleListDate } from '../lib/article-model';
interface Props { articles: Article[]; lang: Language }
const { articles, lang } = Astro.props;
---
<ul class="article-list">
  {articles.map((article) => (
    <li class="editorial-row">
      <time datetime={article.data.published}>{formatArticleListDate(article.data.published, lang)}</time>
      <h3><a href={articleUrl(article)}>{article.data.title}</a></h3>
      <span class="article-category">{articleCategoryLabels[article.data.category][lang]}</span>
    </li>
  ))}
</ul>
