---
interface Props {
  project: { name: string; href: string; description: string; status: string };
  headingLevel: 2 | 3;
}
const { project, headingLevel } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---
<article class="editorial-row project">
  <div class="project-summary">
    <Heading><a href={project.href}>{project.name}</a></Heading>
    <p>{project.description}</p>
  </div>
  <p class="project-status">{project.status}</p>
</article>
