---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from './ArticleList.astro';
import ProjectCard from './ProjectCard.astro';
import { getPublicArticles } from '../lib/articles';
import { navigation, type Language } from '../data/navigation';
import { pageDescriptions } from '../data/page-descriptions';
interface Props { lang: Language }
const { lang } = Astro.props;
const es = lang === 'es';
const links = navigation[lang];
const articles = (await getPublicArticles(lang)).slice(0, 3);
const description = pageDescriptions[lang].home;
const other = es ? 'en' : 'es';
const intro = es ? 'Soy Fernando. Me gusta la tecnología, crear proyectos y seguir aprendiendo. En esta web comparto experiencias, ideas y cosas que me parecen interesantes o que creo que pueden resultar útiles a otros.' : "I'm Fernando. I enjoy technology, building projects, and learning new things. On this site, I share experiences, ideas, and things I find interesting or think others might find useful.";
---
<BaseLayout lang={lang} page="home" title={links.home.label} description={description} translationHref={navigation[other].home.href}>
  <div class="editorial-container page-start section-stack">
  <section class="home-intro" aria-labelledby="intro-title">
    <h1 id="intro-title">{es ? 'Siempre hay algo nuevo que aprender.' : 'Developing the future.'}</h1>
    <p class="lead">{intro}</p>
    <ul class="intro-links">
      <li><a href={links.projects.href}>{es ? 'Explorar proyectos' : 'Explore projects'} <span aria-hidden="true">→</span></a></li>
      <li><a href={links.articles.href}>{es ? 'Leer artículos' : 'Read articles'} <span aria-hidden="true">→</span></a></li>
    </ul>
  </section>
  <section class="home-section" aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">{es ? 'Proyectos destacados' : 'Featured projects'}</h2>
      <a href={links.projects.href}>{es ? 'Todos los proyectos' : 'All projects'}</a>
    </div>
    <ProjectCard lang={lang} headingLevel={3} />
  </section>
  <section class="home-section" aria-labelledby="articles-title">
    <div class="section-heading">
      <h2 id="articles-title">{es ? 'Artículos recientes' : 'Recent articles'}</h2>
      <a href={links.articles.href}>{es ? 'Todos los artículos' : 'All articles'}</a>
    </div>
    {articles.length > 0 ? <ArticleList articles={articles} lang={lang} /> : <p class="empty-articles">{es ? 'Todavía no hay artículos publicados.' : 'No articles have been published yet.'}</p>}
  </section>
  </div>
</BaseLayout>
